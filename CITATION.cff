    given-names: Orkhan
    affiliation: "Pollice Research Group, Stratingh Institute for Chemistry, University of Groningen"
repository-code: "https://github.com/0rkhann/nhc-bo-benchmark"
license: MIT
version: 1.0.0
keywords:
  - bayesian-optimization
  - molecular-design
  - cheminformatics
  - gaussian-processes
  - benchmark
